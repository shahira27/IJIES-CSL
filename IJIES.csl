<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" demote-non-dropping-particle="never" default-locale="en-US">
  <info>
    <title>International Journal of Intelligent Engineering and Systems (IJIES)</title>
    <title-short>IJIES</title-short>
    <id>http://www.zotero.org/styles/ijies-custom</id>
    <link href="http://www.zotero.org/styles/ijies-custom" rel="self"/>
    <updated>2026-10-07T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">Custom CSL style based on the published IJIES reference examples.</rights>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="page" form="short">pp.</term>
      <term name="section" form="short">No.</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="always"/>
      <label prefix=", " form="short"/>
    </names>
  </macro>

  <macro name="title">
    <text variable="title" quotes="true" text-case="sentence"/>
  </macro>

  <macro name="journal">
    <group delimiter=", ">
      <text variable="container-title"/>
      <group delimiter=", ">
        <text variable="volume" prefix="Vol. "/>
        <text variable="issue" prefix="No. "/>
        <text variable="page" prefix="pp. "/>
      </group>
    </group>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="doi">
    <text variable="DOI" prefix="doi: "/>
  </macro>

  <citation collapse="citation-number" after-collapse-delimiter=", ">
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography et-al-min="7" et-al-use-first="6" second-field-align="flush" entry-spacing="0" line-spacing="1">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="title"/>
        <choose>
          <if type="article-journal" match="any">
            <text macro="journal"/>
            <text macro="issued"/>
            <text macro="doi"/>
          </if>
          <else-if type="paper-conference conference-paper proceedings article" match="any">
            <group delimiter=", ">
              <text variable="container-title" prefix="In: "/>
              <text variable="event-place"/>
              <text variable="page" prefix="pp. "/>
              <text macro="issued"/>
              <text macro="doi"/>
            </group>
          </else-if>
          <else-if type="book chapter entry-dictionary entry-encyclopedia" match="any">
            <group delimiter=", ">
              <text variable="container-title"/>
              <text variable="publisher"/>
              <text variable="publisher-place"/>
              <text macro="issued"/>
              <text macro="doi"/>
            </group>
          </else-if>
          <else-if type="webpage post-weblog" match="any">
            <text variable="container-title"/>
            <text variable="URL" prefix="Available: "/>
              <date variable="accessed" prefix=", accessed ">
                <date-part name="day" suffix=" "/>
                <date-part name="month" suffix=" "/>
                <date-part name="year"/>
              </date>
          </else-if>
          <else>
            <group delimiter=", ">
              <text variable="publisher"/>
              <text variable="publisher-place"/>
              <text macro="issued"/>
              <text macro="doi"/>
            </group>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
